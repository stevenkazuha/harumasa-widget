{
  "name": "@local/harumasa-widget",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A Q-version Asaba Harumasa corner pet for the Harness Web GUI.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.png"
  },
  "files": ["index.js", "client.js", "pet.js", "cordis.patch.yml", "locale/*.json", "icon.png", "icon.svg", "preview.png"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-layout"]
    }
  }
}
